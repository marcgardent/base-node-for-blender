// Base Node Standard Library — Module fillet2d
// @module fillet2d
// @version 1.0.0
// @target blender
// @edition 2026
// @description Fillets, chamfers, and bevels for 2D polygonal curves and corners

use math (perpendicular)

// ---- 2D Fillets, Chamfers & Bevels ----

geometry graph "fillet corner"(
    p_prev: Vector,
    p: Vector,
    p_next: Vector,
    radius: Float = 0.2 in 0.0..
) -> (p1: Vector, p2: Vector, center: Vector) {
  "Analytically computes circular arc fillet tangent points (p1, p2) and circle center for a 2D corner"
  v1 = normalize(p_prev - p)
  v2 = normalize(p_next - p)
  cos_theta = Clamp(value: v1 ⋅ v2, min: -1.0, max: 1.0)
  angle = acos(cos_theta)
  half_angle = Clamp(value: angle * 0.5, min: 0.001, max: 1.570796)
  tan_half = tan(half_angle)
  sin_half = sin(half_angle)
  d = radius / tan_half
  h = radius / sin_half
  bisector = normalize(v1 + v2)
  p1 = p + v1 * d
  p2 = p + v2 * d
  c = p + bisector * h
  return (p1: p1, p2: p2, center: c)
}

geometry graph "fillet polygon"(
    polygon: Geometry,
    radius: Float = 0.2 in 0.0..,
    segments: Int = 4 in 1..64
) -> Geometry {
  "Rounds sharp corners of a 2D polygonal curve with constant or attribute-driven fillet radius"
  // Each corner becomes an arc of segments straight segments, a poly curve's as a Bézier curve's
  return FilletCurve(polygon, radius: radius, mode: "Poly", count: segments)
}

geometry graph "chamfer polygon"(polygon: Geometry, distance: Float = 0.1 in 0.0..) -> Geometry {
  "Cuts sharp corners of a 2D polygon with straight chamfers"
  // A cut from distance before each corner to distance after it: the fillet of one segment whose
  // radius puts its ends there, distance × tan(angle / 2) at a corner of that angle
  p = Position()
  prev = EvaluateAtIndex[FLOAT_VECTOR](value: p, index: OffsetPointInCurve(offset: -1).point_index)
  next = EvaluateAtIndex[FLOAT_VECTOR](value: p, index: OffsetPointInCurve(offset: 1).point_index)
  cos_angle = Clamp(value: normalize(prev - p) ⋅ normalize(next - p), min: -1.0, max: 1.0)
  half_angle = Clamp(value: acos(cos_angle) * 0.5, min: 0.0, max: 1.570796)
  return FilletCurve(polygon, radius: distance * tan(half_angle), mode: "Poly", count: 1)
}

geometry graph "fillet bezier handles"(
    curve: Geometry,
    radius: Float = 0.1 in 0.0..,
    threshold_angle: Float = 0.5 in 0.0..3.14159
) -> Geometry {
  "Smooths the kinks of a 2D curve sharper than threshold_angle with Bézier rounding arcs; a poly curve, which has no handles, is cut straight there"
  // A kink is a point where the curve turns by more than threshold_angle: it becomes two points
  // whose Bézier handles draw the arc; a point where the curve turns less is left as it is
  p = Position()
  prev = EvaluateAtIndex[FLOAT_VECTOR](value: p, index: OffsetPointInCurve(offset: -1).point_index)
  next = EvaluateAtIndex[FLOAT_VECTOR](value: p, index: OffsetPointInCurve(offset: 1).point_index)
  cos_turn = Clamp(value: normalize(p - prev) ⋅ normalize(next - p), min: -1.0, max: 1.0)
  kink = acos(cos_turn) > threshold_angle
  return FilletCurve(curve, radius: kink ? radius : 0.0, mode: "Bézier")
}
