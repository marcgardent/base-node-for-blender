// @module cut_plate_step5
// @title Cut plate, step 5: a sunken panel, raised letters, by parity
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example cut_plate

use fillet2d (chamfer_polygon, fillet_corner, fillet_polygon)
use planar2d (planar_faces)

geometry graph outline(length: Float = 4.4 in 0.0.., width: Float = 1.3 in 0.0..) -> Geometry {
  "A long hexagon, pointed at both ends: the six points of a circle, stretched"
  return CurveCircle(resolution: 6, radius: 1.0).curve
    |> TransformGeometry(scale: CombineXYZ(x: length * 0.5, y: width / 1.732, z: 1.0))
}

geometry graph layer(faces: Geometry, bottom: Float, top: Float = 0.1) -> Geometry {
  "Flat faces lifted to bottom and pushed up to top: a top, its walls, open underneath"
  return faces
    |> SetPosition(offset: CombineXYZ(z: bottom))
    |> ExtrudeMesh(offset: (0.0, 0.0, 1.0), offset_scale: top - bottom, individual: false).mesh
}

geometry graph corner_radius(tip: Float = 0.3 in 0.0.., side: Float = 0.1 in 0.0..) -> Float {
  "The radius of each corner of the outline: tip at the two points on the x axis, side elsewhere"
  return abs(Position().y) < 0.001 ? tip : side
}

geometry graph rounded(
    polygon: Geometry,
    tip: Float = 0.3 in 0.0..,
    side: Float = 0.1 in 0.0..
) -> Geometry {
  "The polygon, its corners rounded into arcs of 12 segments"
  return polygon
    |> fillet_polygon(radius: corner_radius(tip: tip, side: side), segments: 12)
}

geometry graph corner_centres(polygon: Geometry, radius: Float = 0.3 in 0.0..) -> Geometry {
  "A point per corner of the polygon, at the centre of the arc a fillet of that radius draws there"
  n = DomainSize[CURVE](polygon).point_count
  i = Index()
  arc = fillet_corner(
    p_prev: SampleIndex[FLOAT_VECTOR](polygon, value: Position(), index: mod(i + n - 1, n)),
    p: Position(),
    p_next: SampleIndex[FLOAT_VECTOR](polygon, value: Position(), index: mod(i + 1, n)),
    radius: radius)
  return polygon
    |> CurveToPoints[EVALUATED]().points
    |> SetPosition(position: arc.center)
}

geometry graph screw_holes(polygon: Geometry, hole: Float = 0.1 in 0.0..) -> Geometry {
  "A circle of radius hole around the centre of each tip's arc"
  return corner_centres(polygon, radius: corner_radius())
    |> DeleteGeometry(selection: abs(Position().y) > 0.001)
    |> InstanceOnPoints(instance: CurveCircle(resolution: 32, radius: hole).curve)
    |> RealizeInstances()
}

geometry graph lettering(text: String = "BASE NODE", size: Float = 0.42 in 0.0..) -> Geometry {
  "The outlines of the letters of text, centred on the origin: closed curves, a few per letter"
  return StringToCurves(
      string: text,
      size: size,
      align_x: "Center",
      align_y: "Middle").curve_instances
    |> RealizeInstances()
}

geometry graph panel(
    length: Float = 2.6 in 0.0..,
    width: Float = 0.62 in 0.0..,
    chamfer: Float = 0.1 in 0.0..
) -> Geometry {
  "A rectangle, its corners cut at 45 degrees: a poly curve, which the fillet cuts straight"
  return Quadrilateral(width: length, height: width).curve
    |> chamfer_polygon(distance: chamfer)
}

geometry graph cut_plate(
    thickness: Float = 0.08 in 0.0..,
    depth: Float = 0.025 in 0.0..
) -> Geometry {
  "A plate, a panel sunk depth into it, and the letters standing in the panel at the plate's height"
  polygon = outline()
  edge = rounded(polygon) + screw_holes(polygon)
  under = planar_faces(edge)
  // Inside the edge 1 line, inside the panel 2, inside a letter 3, inside its counter 4: odd stands up
  raised = planar_faces(edge + panel() + lettering())
  return JoinGeometry(
    layer(under, top: thickness - depth),
    FlipFaces(under),
    layer(raised, bottom: thickness - depth, top: thickness))
}
