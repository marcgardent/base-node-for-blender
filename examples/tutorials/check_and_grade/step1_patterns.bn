// @module check_and_grade_step1
// @title Check and grade a shot, step 1: test patterns
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @target blender
// @offer groups

use merge (keymix)
use qc (color_bars, ramp, zebra, false_color)

compositor graph check_and_grade() -> Color {
  "Three test patterns of the render's size, top to bottom: the colour bars at 75 %, a ramp from 0 to 1 with zebra stripes above 0.9, the same ramp in false colour"
  // The patterns read only the size of the image they are given, never its pixels
  frame = RenderLayers().image
  y = ImageCoordinates(frame).normalized.y
  gray = ramp(frame)
  middle = keymix(zebra(gray, level: 0.9), false_color(gray), y > 1.0 / 3.0)
  return keymix(color_bars(frame), middle, y > 2.0 / 3.0)
}
