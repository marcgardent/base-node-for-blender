// @module shaping_motion_step4
// @title Shaping motion, step 4: ten curves side by side
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example shaping_motion

use math (
  sine01,
  triangle,
  square,
  parabola,
  bump,
  impulse,
  ease_in_out,
  bounce,
  recoil,
  elastic,
  palette,
)

shader(material: true) graph Painted() -> (surface: Shader) {
  "Satin paint of the colour the geometry stores in its attribute color"
  return (
    surface: PrincipledBSDF(
      base_color: Attribute[attribute_name: "color"]().color,
      roughness: 0.45))
}

geometry graph shade(value: Float) -> Color {
  "A colour for a value from 0 to 1: azure at 0, green at 0.5, orange at 1"
  return palette(value, c: (0.5, 0.5, 0.5), d: (0.5, 0.75, 0.0))
}

geometry graph column() -> Geometry {
  "A column 8 cm wide and 1 m high, standing on the origin"
  return Cube(size: (0.08, 0.08, 1.0))
    |> TransformGeometry(translation: (0.0, 0.0, 0.5))
}

geometry graph t() -> Float {
  "Where a column stands along its row: 0 at the left end, x = -2 m, and 1 at the right end, x = 2 m"
  return Position().x / 4.0 + 0.5
}

geometry graph row(value: Float, name: String, index: Int, height: Float = 0.4) -> Geometry {
  "One curve: 40 columns along X, each value × height high, and its name on the floor at the left"
  y = (index - 4.5) * 0.7
  bars = MeshLine(
      count: 40,
      start_location: CombineXYZ(x: -2.0, y: y),
      offset: (0.1025641, 0.0, 0.0))
    |> MeshToPoints()
    |> StoreNamedAttribute[FLOAT_COLOR](name: "color", value: shade(value))
    |> InstanceOnPoints(
      instance: column(),
      scale: CombineXYZ(x: 1.0, y: 1.0, z: value * height + 0.05))
    |> RealizeInstances()
  label = StringToCurves(
      string: name,
      size: 0.24,
      align_x: "Right",
      align_y: "Middle").curve_instances
    |> RealizeInstances()
    |> FillCurve()
    |> TransformGeometry(translation: CombineXYZ(x: -2.15, y: y))
    |> StoreNamedAttribute[FLOAT_COLOR](name: "color", value: (0.8, 0.8, 0.8, 1.0))
  return bars + label
}

geometry graph shaping_motion() -> Geometry {
  "Ten curves of the module math, one per row, from the front: t from 0 at the left to 1 at the right"
  x = t()
  return JoinGeometry(
      row(sine01(x), "sine01", 0),
      row(triangle(x), "triangle", 1),
      row(square(x), "square", 2),
      row(parabola(x), "parabola", 3),
      row(bump(x), "bump", 4),
      row(impulse(x), "impulse", 5),
      row(ease_in_out(x), "ease in out", 6),
      row(bounce(x), "bounce", 7),
      row(recoil(x), "recoil", 8),
      row(elastic(x), "elastic", 9))
    |> SetMaterial(material: Painted)
}
