// @module shaping_motion_step5
// @title Shaping motion, step 5: a drop and its ripples
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example shaping_motion

use math (ease_in, impulse, bump, palette)

shader(material: true) graph Painted() -> (surface: Shader) {
  "Satin paint of the colour the geometry stores in its attribute color"
  return (
    surface: PrincipledBSDF(
      base_color: Attribute[attribute_name: "color"]().color,
      roughness: 0.45))
}

geometry graph shade(value: Float) -> Color {
  "A colour for a value from 0 to 1: azure at 0, green at 0.5, orange at 1"
  return palette(value, c: (0.5, 0.5, 0.5), d: (0.5, 0.75, 0.0))
}

geometry graph column() -> Geometry {
  "A column 8 cm wide and 1 m high, standing on the origin"
  return Cube(size: (0.08, 0.08, 1.0))
    |> TransformGeometry(translation: (0.0, 0.0, 0.5))
}

geometry graph columns(value: Float, height: Float = 0.6, count: Int = 40 in 2..) -> Geometry {
  "A square of count × count columns, 4 m wide: each is value × height high, and coloured by value"
  return Grid(size_x: 4.0, size_y: 4.0, vertices_x: count, vertices_y: count)
    |> MeshToPoints()
    |> StoreNamedAttribute[FLOAT_COLOR](name: "color", value: shade(value))
    |> InstanceOnPoints(
      instance: column(),
      scale: CombineXYZ(x: 1.0, y: 1.0, z: value * height + 0.05))
    |> RealizeInstances()
    |> SetMaterial(material: Painted)
}

geometry graph shaping_motion(
    period: Float = 2.5 in 0.1..,
    fall: Float = 0.25 in 0.01..0.9,
    lag: Float = 0.15 in 0.0..,
    stiffness: Float = 14.0,
    crests: Float = 10.0,
    reach: Float = 3.0 in 0.0001..
) -> Geometry {
  "A drop falls on the columns once every period seconds; its ripples run out and die away"
  // u: the time in the loop, from 0 to 1 once every period
  u = fract(SceneTime().seconds / period)
  // The drop falls from 2 m to the water, 0.45 m, faster and faster, during the first fall of the loop
  z = 2.0 - ease_in(u / fall) * 1.55
  drop = UVSphere(segments: 32, rings: 16, radius: 0.1).mesh
    |> SetShadeSmooth()
    |> TransformGeometry(translation: CombineXYZ(z: z))
    |> StoreNamedAttribute[FLOAT_COLOR](name: "color", value: shade(0.0))
    |> SetMaterial(material: Painted)
  // Each column: how long since the ripple reached it, 0 until it does
  p = Position()
  d = length(CombineXYZ(x: p.x, y: p.y))
  local = max(u - fall - d * lag, 0.0)
  // A sudden kick that dies away, carrying a few crests, smaller far from the drop
  ripple = impulse(local, stiffness)
    * sin(local * crests * 6.283185)
    * bump(d, center: 0.0, half_width: reach)
  return columns(ripple * 0.5 + 0.5, height: 0.8) + Switch[GEOMETRY](switch: u < fall, true_: drop)
}
