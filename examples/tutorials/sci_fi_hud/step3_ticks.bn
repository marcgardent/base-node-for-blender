// @module sci_fi_hud_step3
// @title Sci-fi HUD, step 3: ticks and range rings
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example sci_fi_hud

use math (sdf_circle)
use sdf2d (
  sdf_arc_2d,
  sdf_chamfer_subtraction,
  sdf_cross_2d,
  sdf_hexagon_2d,
  sdf_isolines,
  sdf_polar_repeat_2d,
  sdf_ring_2d,
  sdf_segment_2d,
)

shader graph ink(d: Float, width: Float = 0.006 in 0.0..) -> Float {
  "1 inside a shape, 0 outside, blended over width across its contour: a line drawn from a distance"
  return Clamp(value: 0.5 - d / width)
}

shader graph dial(p: Vector) -> (distance: Float, faint: Float) {
  "The distance to the pieces of the dial, and to its faint scale: ticks, range rings, crosshair"
  // The bezel: a ring with four gaps, a cross taken out of it with bevelled corners
  bezel = sdf_ring_2d(sdf_circle(p, radius: 1.55), thickness: 0.06)
  gaps = sdf_cross_2d(p, length: 2.0, thickness: 0.09)
  cut = sdf_chamfer_subtraction(bezel, gaps, chamfer: 0.03)
  // Two brackets outside it, top and bottom: one arc, and the same arc seen in a mirror
  top = sdf_arc_2d(p, aperture: 0.6, radius: 1.68, thickness: 0.035)
  bottom = sdf_arc_2d(CombineXYZ(x: p.x, y: -p.y), aperture: 0.6, radius: 1.68, thickness: 0.035)
  inner = sdf_ring_2d(sdf_circle(p, radius: 1.2), thickness: 0.02)
  // The reticle: a hexagon outline, x and y swapped to stand it on a corner
  reticle = sdf_ring_2d(sdf_hexagon_2d(CombineXYZ(x: p.y, y: p.x), radius: 0.16), thickness: 0.015)
  // 60 ticks: one segment, drawn in the sector each point folds into
  minor = sdf_segment_2d(
    sdf_polar_repeat_2d(p, sectors: 60),
    a: (1.3, 0.0, 0.0),
    b: (1.4, 0.0, 0.0),
    thickness: 0.008)
  // Every fifth one longer and thicker: 12 sectors of their own
  major = sdf_segment_2d(
    sdf_polar_repeat_2d(p, sectors: 12),
    a: (1.26, 0.0, 0.0),
    b: (1.44, 0.0, 0.0),
    thickness: 0.018)
  // Range rings every 0.25 m: the contour lines of the distance to the centre, kept inside 1.1 m
  r = length(CombineXYZ(x: p.x, y: p.y))
  rings = max(sdf_isolines(r, step: 0.25, width: 0.005), r - 1.1)
  // A crosshair: two segments, kept outside the reticle
  hair = min(
    sdf_segment_2d(p, a: (-1.1, 0.0, 0.0), b: (1.1, 0.0, 0.0), thickness: 0.004),
    sdf_segment_2d(p, a: (0.0, -1.1, 0.0), b: (0.0, 1.1, 0.0), thickness: 0.004))
  scale = min(rings, max(hair, 0.24 - r))
  // A union is the smallest distance: the nearest piece wins
  pieces = min(min(cut, min(top, bottom)), min(inner, reticle))
  return (distance: min(pieces, min(minor, major)), faint: scale)
}

shader(material: true) graph Hud() -> (surface: Shader) {
  "The dial drawn in cyan light"
  p = TextureCoordinate().object
  d = dial(p)
  light = ink(d: d.distance) + ink(d: d.faint) * 0.35
  return (surface: Emission(color: (0.25, 0.85, 1.0, 1.0), strength: light * 1.2))
}

geometry graph sci_fi_hud(size: Float = 3.6 in 0.0..) -> Geometry {
  "A flat screen, size metres square, that the material Hud draws on"
  return Grid(size_x: size, size_y: size, vertices_x: 2, vertices_y: 2).mesh
    |> SetMaterial(material: Hud)
}
